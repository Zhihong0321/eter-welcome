# Port this app listens on locally (Railway sets PORT itself in production).
PORT=4000

# The Solar Calculator v2 production domain. All customer data (invoices,
# quotations, SEDA form) is fetched directly from this domain's public API —
# this app has no database of its own.
SOLAR_APP_BASE_URL=https://calculator.atap.solar

# The admin domain's public API — used only to fetch official receipts
# (one per verified payment). No login/token required.
ADMIN_APP_BASE_URL=https://admin.atap.solar
